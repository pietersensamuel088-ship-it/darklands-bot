# ============================================================
#  Darklands SMP Bot — Environment Configuration
# ============================================================

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Guild (server) ID
GUILD_ID=your_guild_id_here

# Channel ID where welcome messages are posted
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# Optional: override default SQLite path with a full PostgreSQL URL
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
